# 공공기관 SaaS 플랫폼 — 환경 변수 예시
# Design Ref: D-P00.7 §환경 설정
# CSAP: D-12 시스템 개발 보안 — 시크릿 환경 변수 분리 (하드코딩 금지)
#
# 사용법:
#   cp docs/demo/env.example .env
#   .env 파일을 실제 값으로 수정 후 사용
#
# 주의: .env 파일은 절대 git 커밋 금지 (.gitignore에 등록됨)

# ============================================================
# DB (PostgreSQL 16)
# docker-compose.yml의 postgres 서비스와 동일
# ============================================================
DATABASE_URL="postgresql://saas:saas_dev_2026@localhost:5432/saas_platform"

# ============================================================
# Redis 7
# ============================================================
REDIS_URL="redis://:redis_dev_2026@localhost:6379"

# ============================================================
# MinIO (오브젝트 스토리지 — CSAP D-09 AES-256 암호화)
# ============================================================
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="minio_admin"
MINIO_SECRET_KEY="minio_dev_2026"
MINIO_BUCKET="saas-files"

# ============================================================
# Portal (Next.js — platform/apps/portal)
# ============================================================
NEXTAUTH_SECRET="demo-secret-change-in-production-must-be-32chars-min"
NEXTAUTH_URL="http://localhost:4000"
NEXT_PUBLIC_API_GATEWAY_URL="http://localhost:4000"

# ============================================================
# 암호화 키 (CSAP D-09 AES-256)
# 운영 환경: openssl rand -base64 32 로 생성
# ============================================================
ENCRYPTION_KEY="demo-encryption-key-change-in-production-32chars"

# ============================================================
# AI Gateway (N2SF N-05 — O등급 데이터만 전송)
# 외부 AI API 직접 호출 금지, 반드시 게이트웨이 경유
# ============================================================
AI_GATEWAY_URL="http://ai-gateway.internal/v1"
AI_GATEWAY_TOKEN="gateway-token-replace-in-production"
