# ============================================================
# 공공기관 SaaS 플랫폼 — 환경 변수 템플릿
# ============================================================
# Design Ref: D-P00.7 환경 설정
# CSAP: D-12 시스템 개발 보안 — 시크릿 환경 변수 분리 (하드코딩 금지)
# CSAP: D-09 암호화 — 암호화 키 환경 변수 필수
#
# 사용법:
#   cp .env.example .env
#   .env 파일을 실제 값으로 수정 후 사용
#
# 주의: .env 파일은 절대 git 커밋 금지 (.gitignore에 등록됨)
# ============================================================

# ----------------------------------------------------------------
# 공통 (전 서비스 공유)
# ----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ----------------------------------------------------------------
# PostgreSQL 16 (docker-compose.yml 참조)
# ----------------------------------------------------------------
DB_USER=saas
DB_PASSWORD=your-db-password-here
DB_NAME=saas_platform
DB_PORT=5432
DATABASE_URL="postgresql://saas:your-db-password-here@localhost:5432/saas_platform"

# ----------------------------------------------------------------
# Redis 7 (세션 관리, 토큰 블랙리스트 — CSAP D-08)
# ----------------------------------------------------------------
REDIS_PASSWORD=your-redis-password-here
REDIS_PORT=6379
REDIS_URL="redis://default:your-redis-password-here@localhost:6379"

# ----------------------------------------------------------------
# JWT 인증 (RSA RS256 — CSAP D-08-01)
# 생성: openssl genrsa -out private.pem 2048
#       openssl rsa -in private.pem -pubout -out public.pem
# PEM 내용을 한 줄로 변환 입력 (newline -> literal newline 유지)
# ----------------------------------------------------------------
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"

# ----------------------------------------------------------------
# 암호화 키 (CSAP D-09 — AES-256)
# 생성: openssl rand -hex 32
# ----------------------------------------------------------------

# MFA 시크릿 암호화 키 (auth-service, 64자 hex = 32바이트)
MFA_ENCRYPTION_KEY=your-64-char-hex-key-here-generate-with-openssl-rand-hex-32

# 파일 암호화 키 (file-service, 64자 hex = 32바이트)
FILE_ENCRYPTION_KEY=your-64-char-hex-key-here-generate-with-openssl-rand-hex-32

# 일반 데이터 암호화 키 (범용)
ENCRYPTION_KEY=your-encryption-key-here-minimum-32-characters

# ----------------------------------------------------------------
# MinIO 오브젝트 스토리지 (CSAP D-09 파일 암호화)
# ----------------------------------------------------------------
MINIO_USER=minio_admin
MINIO_PASSWORD=your-minio-password-here
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_BUCKET=saas-files

# ----------------------------------------------------------------
# API Gateway (port 3000)
# ----------------------------------------------------------------
API_GATEWAY_PORT=3000
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3100,http://localhost:3200,http://localhost:4000
ENABLE_SWAGGER=true

# 서비스 간 내부 인증 키 (notification-service, user-service 등)
# 운영 환경: 반드시 강력한 랜덤 값으로 설정
INTERNAL_SERVICE_KEY=your-internal-service-key-here

# ----------------------------------------------------------------
# 마이크로서비스 포트 (기본값 사용 시 생략 가능)
# ----------------------------------------------------------------
AUTH_SERVICE_PORT=3001
AUTH_SERVICE_HOST=0.0.0.0
USER_SERVICE_PORT=3002
USER_SERVICE_HOST=0.0.0.0
TENANT_SERVICE_PORT=3003
TENANT_SERVICE_HOST=0.0.0.0
# MENU_SERVICE_PORT=3004
# CATALOG-SERVICE_PORT=3005
# SUBSCRIPTION-SERVICE_PORT=3006
# BILLING-SERVICE_PORT=3007
# CRM-SERVICE_PORT=3008
# AI-SERVICE_PORT=3009
# NOTIFICATION_SERVICE_PORT=3010
# FILE-SERVICE_PORT=3011
# AUDIT-SERVICE_PORT=3012
# COMPLIANCE-SERVICE_PORT=3013
# SECURITY_SERVICE_PORT=3014
# SECURITY_MONITOR_SERVICE_PORT=3015

# ----------------------------------------------------------------
# 서비스 간 URL (docker-compose 내부에서는 서비스명 사용)
# 로컬 개발 시 localhost 사용
# ----------------------------------------------------------------
AUTH_SVC_URL=http://localhost:3001
USER_SVC_URL=http://localhost:3002
TENANT_SVC_URL=http://localhost:3003
MENU_SVC_URL=http://localhost:3004
CATALOG_SVC_URL=http://localhost:3005
SUBSCRIPTION_SVC_URL=http://localhost:3006
BILLING_SVC_URL=http://localhost:3007
CRM_SVC_URL=http://localhost:3008
AI_SVC_URL=http://localhost:3009
NOTIFICATION_SVC_URL=http://localhost:3010
FILE_SVC_URL=http://localhost:3011
AUDIT_SVC_URL=http://localhost:3012
AUDIT_SERVICE_URL=http://localhost:3012
COMPLIANCE_SVC_URL=http://localhost:3013
SECURITY_SVC_URL=http://localhost:3014
AUTH_SERVICE_URL=http://localhost:3001

# ----------------------------------------------------------------
# AI Gateway (N2SF N-05 — O등급 데이터만 전송)
# 외부 AI API 직접 호출 금지, 반드시 게이트웨이 경유
# ----------------------------------------------------------------
AI_GATEWAY_URL=http://ai-gateway.internal/v1
AI_GATEWAY_TOKEN=your-gateway-token-here

# LM Studio (로컬 AI 모델 서버)
LM_STUDIO_URL=http://host.docker.internal:1234

# ----------------------------------------------------------------
# Portal (Next.js — platform/apps/portal, port 4000)
# ----------------------------------------------------------------
NEXTAUTH_SECRET=your-nextauth-secret-minimum-32-characters
NEXTAUTH_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:3000
NEXT_PUBLIC_AUDIT_SERVICE_URL=http://localhost:3012

# ----------------------------------------------------------------
# 공공데이터 포털 연동 (플러그인)
# ----------------------------------------------------------------
DATA_PORTAL_API_KEY=your-data-portal-api-key-here

# ----------------------------------------------------------------
# 서비스별 포트 (추가 서비스)
# ----------------------------------------------------------------
NOTIFICATION_SERVICE_PORT=3010
SAAS_CATALOG_SERVICE_PORT=3016
SECURITY_MONITOR_PORT=3015
SECURITY_SERVICE_PORT=3014

# ----------------------------------------------------------------
# 보안 설정 (CSAP D-08, D-10)
# ----------------------------------------------------------------
# 서비스 간 인증 시크릿 (auth-service)
SERVICE_AUTH_SECRET=your-service-auth-secret-here

# JWT Key ID (RS256 키 식별자)
JWT_KEY_ID=saas-key-1

# IP 접근 제어 (쉼표 구분 CIDR)
IP_WHITELIST=
IP_BLACKLIST=

# 비밀번호 정책
PASSWORD_HISTORY_COUNT=5
INACTIVE_THRESHOLD_DAYS=90

# ----------------------------------------------------------------
# Rate Limit 설정 (CSAP D-10 DoS 방어)
# ----------------------------------------------------------------
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=300000
RATE_LIMIT_REFRESH_MAX=10
RATE_LIMIT_REFRESH_WINDOW=60000
RATE_LIMIT_PASSWORD_MAX=3
RATE_LIMIT_PASSWORD_WINDOW=600000
BODY_LIMIT_BYTES=10485760

# ----------------------------------------------------------------
# AI 서비스 상세 설정 (N2SF N-05)
# ----------------------------------------------------------------
AI_DAILY_TOKEN_LIMIT=100000
PROMPT_GUARD_THRESHOLD=0.8

# ----------------------------------------------------------------
# OpenTelemetry 설정 (관측성)
# ----------------------------------------------------------------
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ----------------------------------------------------------------
# 테넌트 설정
# ----------------------------------------------------------------
TENANT_STORAGE_LIMIT_MB=1024
SLOW_REQUEST_THRESHOLD_MS=3000

# ----------------------------------------------------------------
# 부하 테스트 (선택)
# ----------------------------------------------------------------
# BASE_URL=http://localhost:3000
# CONCURRENT=10
# DURATION=30
