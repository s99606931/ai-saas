      "title": "CPU 사용률",
      "description": "클러스터 전체 CPU 사용률 (Recording Rule 사전 계산)",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "cluster:cpu_usage:ratio",
          "legendFormat": "CPU 사용률",
          "refId": "A",
          "_comment": "Design Ref: MTU-N90 §2.1 — Recording Rule 기반 (raw 쿼리 대비 10배 빠름)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        }
      }
    },
    {
