{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "Tempo 분산 추적 성능 전체 현황 모니터링 — MTU-N230",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "수집 현황",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "스팬 수신률 (스팬/초)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "tempo:ingester:spans_received_rate5m",
          "legendFormat": "스팬/초"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 20 }
        }
      }
    },
    {
      "title": "수신 바이트 (MB/초)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "tempo:ingester:bytes_received_rate5m_mb",
          "legendFormat": "MB/초"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "MBs",
          "custom": { "drawStyle": "line", "fillOpacity": 20 }
        }
      }
    },
    {
      "title": "활성 트레이스",
      "type": "stat",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "tempo:ingester:live_traces",
          "legendFormat": "활성 트레이스"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 30000 },
              { "color": "red", "value": 50000 }
            ]
          }
        }
      }
    },
    {
      "title": "WAL / 스토리지",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "collapsed": false
    },
    {
      "title": "스팬 드롭률 (%)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "tempo:pipeline:span_drop_ratio * 100",
          "legendFormat": "드롭률 %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          }
        }
      }
    },
    {
      "title": "저장 블록 수",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "tempo:ingester:blocks_count",
          "legendFormat": "블록 수"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 15 }
        }
      }
    },
    {
      "title": "드롭 스팬/초",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "tempo:distributor:spans_dropped_rate5m",
          "legendFormat": "드롭 스팬/초"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 30 }
        }
      }
    },
    {
      "title": "쿼리 성능",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "collapsed": false
    },
    {
      "title": "쿼리 지연 (p50 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "tempo:query:duration_p50",
          "legendFormat": "p50"
        },
        {
          "expr": "tempo:query:duration_p99",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "쿼리 에러율",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(tempo_request_duration_seconds_count{status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(tempo_request_duration_seconds_count[5m])), 0.001) * 100",
          "legendFormat": "에러율 %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "압축 / 리소스",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "collapsed": false
    },
    {
      "title": "압축 소요 시간 (초)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "tempo:compactor:duration_avg_seconds",
          "legendFormat": "압축 시간"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 15 }
        }
      }
    },
    {
      "title": "Tempo 메모리 (MB)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{container=\"tempo\"}) / 1024 / 1024",
          "legendFormat": "메모리 (MB)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "custom": { "drawStyle": "line", "fillOpacity": 15 }
        }
      }
    },
    {
      "title": "Tempo CPU (millicores)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{container=\"tempo\"}[5m])) * 1000",
          "legendFormat": "CPU (millicores)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 15 }
        }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["tempo", "tracing", "performance", "mtu-n230", "csap-d06"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Tempo 분산 추적 성능 모니터링",
  "uid": "tempo-perf-n230",
  "version": 1
}
