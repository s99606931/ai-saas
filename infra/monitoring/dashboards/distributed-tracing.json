{
  "annotations": { "list": [] },
  "description": "분산 추적 관측성 대시보드 — Tempo + OTel + Span Metrics",
  "editable": true,
  "panels": [
    {
      "title": "서비스 성능 개요",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "요청율 (req/s)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total[5m])) or vector(0)",
          "legendFormat": "Total"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 1 } }
    },
    {
      "title": "에러율",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total{status_code=\"STATUS_CODE_ERROR\"}[5m])) / sum(rate(traces_spanmetrics_calls_total[5m])) * 100 or vector(0)",
          "legendFormat": "Error %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 1, "color": "yellow" },
              { "value": 5, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "title": "P95 응답시간",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_latency_bucket[5m])) by (le)) or vector(0)",
          "legendFormat": "P95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "decimals": 0 } }
    },
    {
      "title": "활성 트레이스 수",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "sum(tempo_ingester_live_traces) or vector(0)",
          "legendFormat": "Live"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "title": "서비스별 요청율 추이",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total[5m])) by (service_name)",
          "legendFormat": "{{ service_name }}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "title": "서비스별 P95 응답시간 추이",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_latency_bucket[5m])) by (le, service_name))",
          "legendFormat": "{{ service_name }}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "title": "HTTP 메서드별 분포",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 13 },
      "targets": [
        {
          "expr": "sum(increase(traces_spanmetrics_calls_total[1h])) by (http_method)",
          "legendFormat": "{{ http_method }}"
        }
      ]
    },
    {
      "title": "HTTP 상태 코드 분포",
      "type": "barchart",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 13 },
      "targets": [
        {
          "expr": "sum(increase(traces_spanmetrics_calls_total[1h])) by (http_status_code)",
          "legendFormat": "{{ http_status_code }}"
        }
      ]
    },
    {
      "title": "Tempo 스토리지 사용량",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 13 },
      "targets": [
        {
          "expr": "tempo_ingester_bytes_received_total",
          "legendFormat": "Bytes Received"
        },
        {
          "expr": "tempo_compactor_bytes_written_total",
          "legendFormat": "Bytes Written"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "title": "트레이스 탐색",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "collapsed": false
    },
    {
      "title": "최근 에러 트레이스 (Tempo)",
      "type": "traces",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 22 },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ status = error } | select(resource.service.name, name, duration)"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "tags": ["tracing", "tempo", "otel", "observability"],
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "Asia/Seoul",
  "title": "분산 추적 (Tempo)",
  "uid": "distributed-tracing",
  "version": 1
}
