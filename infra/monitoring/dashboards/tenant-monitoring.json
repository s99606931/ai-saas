{
  "annotations": { "list": [] },
  "description": "멀티테넌트 모니터링 대시보드 — 테넌트별 리소스 + SLO 격리 뷰",
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "테넌트별 CPU 사용량",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{
        "expr": "tenant:cpu_usage:sum_rate5m{namespace=~\"$tenant\"}",
        "legendFormat": "{{ namespace }}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 2,
      "title": "테넌트별 메모리 사용량",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{
        "expr": "tenant:memory_usage:sum_bytes{namespace=~\"$tenant\"}",
        "legendFormat": "{{ namespace }}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 3,
      "title": "테넌트별 가용성 SLI (1시간)",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{
        "expr": "tenant:availability:ratio1h{namespace=~\"$tenant\"}",
        "legendFormat": "{{ namespace }}",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.99,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.999 },
              { "color": "green", "value": 0.9999 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "테넌트별 P99 지연",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{
        "expr": "tenant:latency_p99:seconds{namespace=~\"$tenant\"}",
        "legendFormat": "{{ namespace }}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 5,
      "title": "테넌트별 요청률 (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{
        "expr": "tenant:request_rate:sum_rate5m{namespace=~\"$tenant\"}",
        "legendFormat": "{{ namespace }}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 6,
      "title": "테넌트별 Pod 수",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{
        "expr": "tenant:pod_count:sum{namespace=~\"$tenant\"}",
        "legendFormat": "{{ namespace }}",
        "refId": "A"
      }]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["multitenant", "isolation", "slo", "공공SaaS"],
  "templating": {
    "list": [
      {
        "name": "tenant",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(tenant:cpu_usage:sum_rate5m, namespace)",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "Asia/Seoul",
  "title": "멀티테넌트 모니터링",
  "uid": "multitenant-monitoring",
  "version": 1
}
