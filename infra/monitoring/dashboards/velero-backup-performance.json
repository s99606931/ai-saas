{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus" }
  ],
  "description": "Velero 백업/복원 성능 모니터링 대시보드 (MTU-N237)",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "백업 상태 개요",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "최근 백업 성공/실패/부분실패 상태",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "fillOpacity": 80, "stacking": { "mode": "normal" } },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "title": "백업 결과 타임라인",
      "targets": [
        { "expr": "velero:backup:success_count5m", "legendFormat": "성공 ({{ schedule }})" },
        { "expr": "velero:backup:failure_count5m", "legendFormat": "실패 ({{ schedule }})" },
        { "expr": "velero:backup:partial_failure_count5m", "legendFormat": "부분실패 ({{ schedule }})" }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "스케줄별 백업 성공률",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.99 }
            ]
          },
          "unit": "percentunit",
          "min": 0, "max": 1
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "title": "백업 성공률 (스케줄별)",
      "targets": [
        { "expr": "velero:backup:success_ratio", "legendFormat": "{{ schedule }}" }
      ],
      "type": "gauge"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "백업 성능",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "백업 소요시간 추이 (p50/p95/p99)",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisLabel": "소요시간", "drawStyle": "line", "fillOpacity": 10, "thresholdsStyle": { "mode": "dashed" } },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 900 },
              { "color": "red", "value": 1800 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 3,
      "title": "백업 소요시간",
      "targets": [
        { "expr": "velero:backup:duration:p50", "legendFormat": "p50 ({{ schedule }})" },
        { "expr": "velero:backup:duration:p95", "legendFormat": "p95 ({{ schedule }})" },
        { "expr": "velero:backup:duration:p99", "legendFormat": "p99 ({{ schedule }})" }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "백업 크기 추이",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisLabel": "크기", "drawStyle": "line", "fillOpacity": 20 },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 4,
      "title": "백업 크기 추이",
      "targets": [
        { "expr": "velero:backup:size_bytes", "legendFormat": "{{ schedule }}" }
      ],
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "복원 성능 및 스케줄 이행률",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "복원 소요시간 (p50/p95)",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisLabel": "소요시간", "drawStyle": "line", "fillOpacity": 15 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 5,
      "title": "복원 소요시간",
      "targets": [
        { "expr": "velero:restore:duration:p50", "legendFormat": "p50" },
        { "expr": "velero:restore:duration:p95", "legendFormat": "p95" }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "마지막 성공 백업 이후 경과시간",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 43200 },
              { "color": "red", "value": 86400 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 6,
      "title": "스케줄 이행률 (마지막 성공 경과)",
      "targets": [
        { "expr": "velero:schedule:last_success_age_seconds", "legendFormat": "{{ schedule }}" }
      ],
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 103,
      "title": "리소스 사용량",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Velero 서버 CPU/메모리 사용량",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 20 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "id": 7,
      "title": "Velero CPU 사용량",
      "targets": [
        { "expr": "velero:cpu:usage_cores", "legendFormat": "{{ pod }}" }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 20 },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "id": 8,
      "title": "Velero 메모리 사용량",
      "targets": [
        { "expr": "velero:memory:usage_bytes", "legendFormat": "{{ pod }}" }
      ],
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["velero", "backup", "restore", "dr", "csap", "round25"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" },
        "name": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "title": "Velero 백업/복원 성능 모니터링",
  "uid": "velero-backup-perf-n237",
  "version": 1
}
