{
  "annotations": { "list": [] },
  "description": "Cert-Manager 인증서 수명주기 모니터링 (Design Ref: MTU-N226, CSAP D-09)",
  "editable": false,
  "graphTooltip": 2,
  "id": null,
  "uid": "certmgr-lifecycle-n226",
  "title": "Cert-Manager 인증서 수명주기",
  "tags": ["certmanager", "tls", "n226", "csap-d09"],
  "timezone": "Asia/Seoul",
  "refresh": "60s",
  "time": { "from": "now-24h", "to": "now" },
  "templating": { "list": [{ "name": "DS_PROMETHEUS", "type": "datasource", "query": "prometheus", "current": { "text": "Prometheus", "value": "Prometheus" } }] },
  "panels": [
    { "id": 100, "title": "인증서 개요", "type": "row", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false },
    { "id": 1, "title": "전체 인증서 수", "type": "stat", "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "expr": "certmanager:cert:total_count", "refId": "A" }] },
    { "id": 2, "title": "Ready", "type": "stat", "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "expr": "certmanager:cert:ready_count", "refId": "A" }], "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } } } },
    { "id": 3, "title": "NotReady", "type": "stat", "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "expr": "certmanager:cert:not_ready_count", "refId": "A" }], "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } } },
    { "id": 4, "title": "만료 30일 이내", "type": "stat", "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "expr": "certmanager:cert:expiring_30d_count", "refId": "A" }], "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }] } } } },
    { "id": 5, "title": "만료 7일 이내", "type": "stat", "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "expr": "certmanager:cert:expiring_7d_count", "refId": "A" }], "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } } },
    { "id": 6, "title": "건강도", "type": "gauge", "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "expr": "certmanager:overall:health_score", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 70 }, { "color": "green", "value": 90 }] } } } },
    { "id": 200, "title": "만료 타임라인", "type": "row", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }, "collapsed": false },
    { "id": 7, "title": "인증서 만료일 목록", "type": "table", "gridPos": { "h": 8, "w": 24, "x": 0, "y": 7 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "expr": "sort(certmanager:cert:expiry_days)", "legendFormat": "{{name}} ({{namespace}})", "refId": "A", "format": "table", "instant": true }], "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 30 }, { "color": "green", "value": 60 }] } } } },
    { "id": 300, "title": "갱신/발급", "type": "row", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }, "collapsed": false },
    { "id": 8, "title": "갱신 성공률", "type": "stat", "gridPos": { "h": 5, "w": 12, "x": 0, "y": 16 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "expr": "certmanager:renewal:success_rate", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 90 }, { "color": "green", "value": 99 }] } } } },
    { "id": 9, "title": "Issuer Ready 수", "type": "stat", "gridPos": { "h": 5, "w": 12, "x": 12, "y": 16 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "expr": "certmanager:issuer:ready_count", "refId": "A" }], "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } } } },
    { "id": 400, "title": "ACME/Issuer", "type": "row", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 }, "collapsed": false },
    { "id": 10, "title": "ACME Order 성공률", "type": "gauge", "gridPos": { "h": 5, "w": 12, "x": 0, "y": 22 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "expr": "certmanager:acme:order_success_rate", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 80 }, { "color": "green", "value": 95 }] } } } },
    { "id": 11, "title": "ACME 챌린지 대기", "type": "stat", "gridPos": { "h": 5, "w": 12, "x": 12, "y": 22 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "expr": "certmanager:acme:challenge_pending", "refId": "A" }], "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 2 }, { "color": "red", "value": 5 }] } } } }
  ],
  "schemaVersion": 39,
  "version": 1,
  "weekStart": "monday"
}
