{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus" }
  ],
  "description": "KEDA Autoscaler 성능 모니터링 대시보드 (MTU-N239)",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "ScaledObject 현황",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "활성/오류 ScaledObject 수",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "title": "ScaledObject 오류",
      "targets": [
        { "expr": "keda:scaledobject:error_count", "legendFormat": "오류" }
      ],
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "활성 ScaledObject 수",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "title": "활성 ScaledObject",
      "targets": [
        { "expr": "keda:scaledobject:active", "legendFormat": "활성" },
        { "expr": "keda:scaledobject:total", "legendFormat": "전체" }
      ],
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "스케일링 이벤트 빈도 (분당)",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 20 },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "title": "스케일링 이벤트 빈도 (분당)",
      "targets": [
        { "expr": "keda:scaling:events_per_minute", "legendFormat": "이벤트/분" }
      ],
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "트리거 및 Operator 성능",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "트리거 메트릭 수집 지연 (p95/p99)",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisLabel": "지연 (초)", "drawStyle": "line", "fillOpacity": 15, "thresholdsStyle": { "mode": "dashed" } },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 30 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 4,
      "title": "트리거 수집 지연",
      "targets": [
        { "expr": "keda:trigger:latency:p95", "legendFormat": "p95" },
        { "expr": "keda:trigger:latency:p99", "legendFormat": "p99" }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Operator 재조정 소요시간 (p95/p99)",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisLabel": "소요시간 (초)", "drawStyle": "line", "fillOpacity": 15 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 5,
      "title": "Operator 재조정 소요시간",
      "targets": [
        { "expr": "keda:operator:reconcile:duration:p95", "legendFormat": "p95 ({{ controller }})" },
        { "expr": "keda:operator:reconcile:duration:p99", "legendFormat": "p99 ({{ controller }})" }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "트리거 오류율 및 재조정 오류율",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 30 },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.02 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "id": 6,
      "title": "오류율 (트리거 + Operator)",
      "targets": [
        { "expr": "keda:trigger:error:ratio", "legendFormat": "트리거 오류율" },
        { "expr": "keda:operator:reconcile:error_ratio", "legendFormat": "재조정 오류율" }
      ],
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "id": 102,
      "title": "리소스 사용량",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "KEDA Operator CPU",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 20 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "id": 7,
      "title": "KEDA CPU 사용량",
      "targets": [
        { "expr": "keda:cpu:usage_cores", "legendFormat": "{{ pod }}" }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "KEDA Operator 메모리",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 20 },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "id": 8,
      "title": "KEDA 메모리 사용량",
      "targets": [
        { "expr": "keda:memory:usage_bytes", "legendFormat": "{{ pod }}" }
      ],
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["keda", "autoscaling", "performance", "sre", "round25"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" },
        "name": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "title": "KEDA Autoscaler 성능 모니터링",
  "uid": "keda-autoscaler-perf-n239",
  "version": 1
}
