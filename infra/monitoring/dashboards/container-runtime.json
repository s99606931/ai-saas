{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus" }
  ],
  "description": "MTU-N180: 컨테이너 런타임 모니터링 - containerd 상태, 이미지 풀, OOM Kill, CrashLoop",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "컨테이너 런타임 종합 현황",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "실행 중 컨테이너",
      "type": "stat",
      "targets": [{ "expr": "cluster:container:running_count", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "OOM Kill (1시간)",
      "description": "FR-N180.3: 최근 1시간 OOM Kill 발생 수",
      "type": "stat",
      "targets": [{ "expr": "cluster:container:oom_kills_1h", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "CrashLoop 컨테이너",
      "description": "FR-N180.4: CrashLoopBackOff 상태 컨테이너 수",
      "type": "stat",
      "targets": [{ "expr": "cluster:container:crashloop_count", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 15 },
              { "color": "red", "value": 30 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "id": 5,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "이미지 풀 P99 지연",
      "description": "FR-N180.2: 이미지 풀 P99 지연시간 (초)",
      "type": "stat",
      "targets": [{ "expr": "cluster:image:pull_duration_p99", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 70 }
            ]
          },
          "unit": "none",
          "min": 0,
          "max": 100
        }
      },
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 6 },
      "id": 6,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal" },
      "title": "런타임 건강 종합 점수",
      "type": "stat",
      "targets": [{ "expr": "cluster:container_runtime:health_score", "refId": "A" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "id": 10,
      "title": "시계열 추이",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 11,
      "title": "컨테이너 재시작 추이",
      "type": "timeseries",
      "targets": [{ "expr": "cluster:container:restarts_1h", "legendFormat": "{{ namespace }}/{{ pod }}/{{ container }}", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 12,
      "title": "이미지 풀 지연 추이",
      "type": "timeseries",
      "targets": [
        { "expr": "cluster:image:pull_duration_p50", "legendFormat": "P50", "refId": "A" },
        { "expr": "cluster:image:pull_duration_p99", "legendFormat": "P99", "refId": "B" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "id": 20,
      "title": "상세 분석",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 20 } } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 21 },
      "id": 21,
      "title": "OOM Kill 이력 (네임스페이스별)",
      "type": "timeseries",
      "targets": [{ "expr": "namespace:container:oom_kills_1h", "legendFormat": "{{ namespace }}/{{ pod }}", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 21 },
      "id": 22,
      "title": "containerd 작업 처리율",
      "type": "timeseries",
      "targets": [{ "expr": "node:containerd:operations_rate", "legendFormat": "{{ instance }}/{{ operation_type }}", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 21 },
      "id": 23,
      "title": "이미지 풀 오류",
      "type": "timeseries",
      "targets": [{ "expr": "cluster:image:pull_errors_15m", "legendFormat": "풀 오류 수", "refId": "A" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "id": 30,
      "title": "이미지 레지스트리 현황",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "decbytes" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "id": 31,
      "title": "이미지 풀 크기 P99",
      "description": "FR-N180.6: 이미지 풀 시 전송되는 데이터 크기",
      "type": "timeseries",
      "targets": [{ "expr": "cluster:image:size_p99", "legendFormat": "P99 크기", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "id": 32,
      "title": "이미지 풀 성공률",
      "description": "FR-N180.6: 이미지 풀 성공률 (%)",
      "type": "timeseries",
      "targets": [{ "expr": "cluster:image:pull_success_rate", "legendFormat": "성공률", "refId": "A" }]
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["container", "runtime", "containerd", "sre", "csap", "MTU-N180"],
  "templating": {
    "list": [
      { "current": {}, "hide": 0, "name": "datasource", "query": "prometheus", "refresh": 1, "type": "datasource" }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "title": "컨테이너 런타임 모니터링",
  "uid": "container-runtime-n180",
  "version": 1
}
