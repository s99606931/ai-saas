      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 5 },
      "targets": [
        {
          "expr": "sum(certmanager_certificate_expiration_timestamp_seconds < bool (time() + 604800)) or vector(0)",
