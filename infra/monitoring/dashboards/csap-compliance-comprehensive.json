  "panels": [
    {
      "title": "CSAP 종합 규정 준수 현황 (경영진 뷰)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "전체 CSAP 준수율",
      "description": "CSAP 13개 도메인 종합 준수율 (D-01 ~ D-13)",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "csap:compliance:total_score or vector(1)",
          "legendFormat": "종합 준수율"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 1,
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "red" },
              { "value": 0.8, "color": "orange" },
              { "value": 0.9, "color": "yellow" },
              { "value": 0.95, "color": "green" }
            ]
          }
        }
      }
    },
    {
      "title": "정책 위반 총 건수",
      "description": "현재 활성 Kyverno + Gatekeeper 위반 건수",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "(sum(policy_report_result{status=\"fail\"}) or vector(0)) + (sum(gatekeeper_violations) or vector(0))",
          "legendFormat": "위반 건수"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 5, "color": "orange" },
              { "value": 20, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "title": "보안 이벤트 (24h)",
      "description": "Falco 런타임 보안 이벤트 수",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 1 },
      "targets": [
        {
          "expr": "sum(increase(falco_events_total[24h])) or vector(0)",
          "legendFormat": "이벤트 수"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 10, "color": "yellow" },
              { "value": 50, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "title": "취약점 (Critical)",
      "description": "Trivy 스캔 Critical 취약점 수",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 5 },
      "targets": [
        {
          "expr": "sum(trivy_image_vulnerabilities{severity=\"Critical\"}) or vector(0)",
          "legendFormat": "Critical"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "title": "인증서 만료 임박",
