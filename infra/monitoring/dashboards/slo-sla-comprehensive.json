{
  "__inputs": [],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "description": "SLO/SLA 종합 대시보드 — 가용성, 응답시간, 에러 버짓 통합 뷰 (Design Ref: MTU-N247 S3.2)",
  "editable": true,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "서비스 가용성 (SLO: 99.9%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "1 - (sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[30d])) / sum(rate(http_server_requests_seconds_count[30d])))",
          "legendFormat": "가용성"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.999 },
              { "color": "green", "value": 0.9995 }
            ]
          },
          "min": 0.99,
          "max": 1,
          "unit": "percentunit"
        }
      }
    },
    {
      "title": "P99 응답 시간 (SLO: 500ms)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket[5m])) by (le))",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.3 },
              { "color": "red", "value": 0.5 }
            ]
          },
          "unit": "s"
        }
      }
    },
    {
      "title": "에러 버짓 잔여 (30일)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "clamp_min(1 - (sum(increase(http_server_requests_seconds_count{status=~\"5..\"}[30d])) / (sum(increase(http_server_requests_seconds_count[30d])) * 0.001)), 0)",
          "legendFormat": "잔여 버짓"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.3 },
              { "color": "green", "value": 0.7 }
            ]
          }
        }
      }
    },
    {
      "title": "서비스별 에러율",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum by (service) (rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.005 },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      }
    },
    {
      "title": "30일 SLO 추이",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "1 - (sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1d])) / sum(rate(http_server_requests_seconds_count[1d])))",
          "legendFormat": "일별 가용성"
        },
        {
          "expr": "0.999",
          "legendFormat": "SLO 목표 (99.9%)"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0.995, "max": 1 }
      }
    },
    {
      "title": "서비스별 P99 추이",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, service) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "{{service}}"
        },
        {
          "expr": "0.5",
          "legendFormat": "SLO (500ms)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "에러 버짓 소진율",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(increase(http_server_requests_seconds_count{status=~\"5..\"}[1h])) / (sum(increase(http_server_requests_seconds_count[1h])) * 0.001)",
          "legendFormat": "시간당 소진율"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit" }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["slo", "sla", "csap", "saas-platform", "MTU-N247"],
  "templating": { "list": [] },
  "time": { "from": "now-30d", "to": "now" },
  "title": "SLO/SLA 종합 대시보드 — 공공기관 SaaS",
  "uid": "saas-slo-comprehensive",
  "version": 1
}
