{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus" }
  ],
  "annotations": { "list": [] },
  "description": "서비스 디스커버리 모니터링 대시보드 — Endpoint, CoreDNS 캐시, 포워드 레이턴시 (Design Ref: MTU-N187 §DS-N187.5, CSAP D-08/D-10)",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "tags": ["dns", "service-discovery"],
      "title": "서비스 디스커버리 관련",
      "type": "dashboards"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "title": "서비스 디스커버리 상태 개요",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "count(kube_endpoint_address_available{namespace=~\"$namespace\"} > 0)",
          "legendFormat": "정상 서비스",
          "refId": "A"
        },
        {
          "expr": "count(kube_endpoint_address_available{namespace=~\"$namespace\"} == 0)",
          "legendFormat": "Endpoint 없음",
          "refId": "B"
        },
        {
          "expr": "sum(kube_endpoint_address_not_ready{namespace=~\"$namespace\"})",
          "legendFormat": "NotReady 총수",
          "refId": "C"
        },
        {
          "expr": "coredns:cache_hit:ratio * 100",
          "legendFormat": "DNS 캐시 히트율 (%)",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "title": "서비스별 Endpoint 가용률",
      "description": "Design Ref: DS-N187.1 — Ready / (Ready + NotReady) 비율",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "service:endpoint_ready:ratio{namespace=~\"$namespace\"} * 100",
          "legendFormat": "{{ namespace }}/{{ endpoint }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": { "mode": "line" }
          },
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "title": "Endpoint 없는 서비스 목록",
      "description": "Design Ref: DS-N187.2 — Ready Endpoint == 0인 서비스",
      "type": "table",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "kube_endpoint_address_available{namespace=~\"$namespace\"} == 0",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Value": true, "__name__": true },
            "renameByName": { "namespace": "네임스페이스", "endpoint": "서비스명" }
          }
        }
      ]
    },
    {
      "title": "CoreDNS 캐시 히트율",
      "description": "Design Ref: DS-N187.3 — 캐시 히트율 (높을수록 효율적)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 18 },
      "targets": [
        {
          "expr": "coredns:cache_hit:ratio * 100",
          "legendFormat": "전체 캐시 히트율",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 80 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "title": "CoreDNS 포워드 레이턴시 (p50/p99)",
      "description": "Design Ref: DS-N187.4 — 업스트림 DNS 포워드 지연",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 18 },
      "targets": [
        {
          "expr": "coredns:forward_latency_p50:seconds * 1000",
          "legendFormat": "p50 ({{ to }})",
          "refId": "A"
        },
        {
          "expr": "coredns:forward_latency_p99:seconds * 1000",
          "legendFormat": "p99 ({{ to }})",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": { "mode": "line" }
          },
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 1000 }
            ]
          }
        }
      }
    },
    {
      "title": "EndpointSlice 변경 빈도",
      "description": "Design Ref: DS-N187.7 — 네임스페이스별 EndpointSlice 변경 수",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "targets": [
        {
          "expr": "endpointslice:changes:rate5m{namespace=~\"$namespace\"}",
          "legendFormat": "{{ namespace }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": { "mode": "normal" }
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "title": "서비스 타입별 분포",
      "description": "Design Ref: DS-N187.5 — ClusterIP/NodePort/LoadBalancer/ExternalName 분포",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "targets": [
        {
          "expr": "count by (type) (kube_service_spec_type{namespace=~\"$namespace\"})",
          "legendFormat": "{{ type }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["service-discovery", "dns", "endpoint", "sre", "csap-d10", "mtu-n187"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(kube_endpoint_address_available, namespace)",
        "name": "namespace",
        "type": "query",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "Asia/Seoul",
  "title": "서비스 디스커버리 모니터링",
  "uid": "service-discovery-n187",
  "version": 1
}
