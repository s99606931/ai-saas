{
  "description": "Webhook 호출 성능 모니터링 대시보드 (MTU-N195)",
  "editable": true,
  "tags": ["webhook", "admission", "performance", "mtu-n195"],
  "title": "Admission Webhook 성능 모니터링",
  "uid": "webhook-perf-n195",
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Webhook 레이턴시 현황",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "red", "value": 0.5 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "title": "Webhook p50 레이턴시",
      "type": "bargauge",
      "options": { "orientation": "horizontal", "displayMode": "gradient" },
      "targets": [
        { "expr": "webhook_perf:latency_p50", "legendFormat": "{{ name }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "red", "value": 0.5 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "title": "Webhook p90 레이턴시",
      "type": "bargauge",
      "options": { "orientation": "horizontal", "displayMode": "gradient" },
      "targets": [
        { "expr": "webhook_perf:latency_p90", "legendFormat": "{{ name }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 1.0 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "title": "Webhook p99 레이턴시",
      "type": "bargauge",
      "options": { "orientation": "horizontal", "displayMode": "gradient" },
      "targets": [
        { "expr": "webhook_perf:latency_p99", "legendFormat": "{{ name }}" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 101,
      "title": "레이턴시 추이",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "id": 4,
      "title": "Webhook 레이턴시 추이 (p99)",
      "type": "timeseries",
      "targets": [
        { "expr": "webhook_perf:latency_p99", "legendFormat": "{{ name }} ({{ type }})" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 102,
      "title": "거부율 및 에러",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "drawStyle": "line", "fillOpacity": 15 },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 30 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "id": 5,
      "title": "Webhook 거부율 추이",
      "type": "timeseries",
      "targets": [
        { "expr": "webhook_perf:rejection_rate_5m", "legendFormat": "{{ name }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "drawStyle": "line", "fillOpacity": 15 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "id": 6,
      "title": "Webhook 에러율 추이",
      "type": "timeseries",
      "targets": [
        { "expr": "webhook_perf:error_rate_5m", "legendFormat": "{{ name }}" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "id": 103,
      "title": "요청량 통계",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "bars", "fillOpacity": 50 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "id": 7,
      "title": "Webhook별 요청률",
      "type": "timeseries",
      "targets": [
        { "expr": "webhook_perf:total_requests_rate_5m", "legendFormat": "{{ name }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "id": 8,
      "title": "유형별(Validating/Mutating) 요청 분포",
      "type": "piechart",
      "targets": [
        { "expr": "webhook_perf:requests_by_type", "legendFormat": "{{ type }}" }
      ]
    }
  ],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "webhook",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(apiserver_admission_webhook_admission_duration_seconds_count, name)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  }
}
