{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus" }
  ],
  "description": "MTU-N183: Job/CronJob 모니터링 - 성공/실패, 스케줄 누락, 실행 시간",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Job/CronJob 종합 현황",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }] }, "unit": "none" } },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "활성 Job",
      "type": "stat",
      "targets": [{ "expr": "sum(kube_job_status_active)", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }] }, "unit": "none" } },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "성공 Job",
      "type": "stat",
      "targets": [{ "expr": "sum(kube_job_status_succeeded)", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }, "unit": "none" } },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "실패 Job",
      "description": "FR-N183.1: 실패 상태 Job 수",
      "type": "stat",
      "targets": [{ "expr": "sum(kube_job_status_failed)", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 80 }, { "color": "green", "value": 95 }] }, "unit": "percent", "min": 0, "max": 100 } },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "id": 5,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Job 성공률",
      "description": "FR-N183.6: 전체 클러스터 Job 성공률",
      "type": "stat",
      "targets": [{ "expr": "cluster:job:success_rate", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }] }, "unit": "none" } },
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "id": 7,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "정지된 CronJob",
      "type": "stat",
      "targets": [{ "expr": "cluster:cronjob:suspended_count", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 50 }, { "color": "green", "value": 70 }] }, "unit": "none", "min": 0, "max": 100 } },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "id": 8,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "건강 점수",
      "type": "stat",
      "targets": [{ "expr": "cluster:job:health_score", "refId": "A" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 10,
      "title": "상세 분석",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 80 } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "id": 11,
      "title": "네임스페이스별 실패 Job",
      "description": "FR-N183.1: 네임스페이스/잡 이름별 실패 수",
      "type": "timeseries",
      "targets": [{ "expr": "namespace:job:failed_count > 0", "legendFormat": "{{ namespace }}/{{ job_name }}", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "id": 12,
      "title": "CronJob 마지막 스케줄 경과 시간",
      "description": "FR-N183.2: 마지막 실행 이후 경과 시간",
      "type": "timeseries",
      "targets": [{ "expr": "namespace:cronjob:time_since_last_schedule", "legendFormat": "{{ namespace }}/{{ cronjob }}", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "bars", "fillOpacity": 60 } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 13,
      "title": "실행 중 Job 경과 시간",
      "description": "FR-N183.3: 장시간 실행 중인 Job",
      "type": "timeseries",
      "targets": [{ "expr": "namespace:job:running_duration_seconds > 0", "legendFormat": "{{ namespace }}/{{ job_name }}", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "percent", "custom": { "drawStyle": "line", "fillOpacity": 15 } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 14,
      "title": "네임스페이스별 Job 성공률",
      "description": "FR-N183.6: 네임스페이스별 Job 성공률 추이",
      "type": "timeseries",
      "targets": [{ "expr": "namespace:job:success_rate", "legendFormat": "{{ namespace }}", "refId": "A" }]
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["job", "cronjob", "batch", "sre", "csap", "MTU-N183"],
  "templating": {
    "list": [
      { "current": {}, "hide": 0, "name": "datasource", "query": "prometheus", "refresh": 1, "type": "datasource" }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "title": "Job/CronJob 모니터링",
  "uid": "job-cronjob-n183",
  "version": 1
}
