{
  "annotations": { "list": [] },
  "description": "Redis 캐시 성능 상세 모니터링 (Design Ref: MTU-N225, CSAP D-12)",
  "editable": false,
  "graphTooltip": 2,
  "id": null,
  "uid": "redis-detail-n225",
  "title": "Redis 캐시 상세 모니터링",
  "tags": ["redis", "cache", "n225", "csap-d12"],
  "timezone": "Asia/Seoul",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [{ "name": "DS_PROMETHEUS", "type": "datasource", "query": "prometheus", "current": { "text": "Prometheus", "value": "Prometheus" } }] },
  "panels": [
    { "id": 100, "title": "개요", "type": "row", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false },
    { "id": 1, "title": "건강도", "type": "gauge", "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "expr": "redis:overall:health_score", "legendFormat": "건강도", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 70 }, { "color": "green", "value": 90 }] } } } },
    { "id": 2, "title": "OPS + 히트율", "type": "stat", "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "expr": "redis:ops:total_rate", "legendFormat": "OPS", "refId": "A" }, { "expr": "redis:cache:hit_rate", "legendFormat": "히트율 %", "refId": "B" }] },
    { "id": 3, "title": "메모리 사용률", "type": "gauge", "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "expr": "redis:memory:usage_ratio", "legendFormat": "사용률", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 80 }, { "color": "red", "value": 95 }] } } } },
    { "id": 4, "title": "키 수", "type": "stat", "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "expr": "redis:keys:total", "legendFormat": "전체", "refId": "A" }, { "expr": "redis:keys:expiring", "legendFormat": "만료 예정", "refId": "B" }] },
    { "id": 200, "title": "커맨드", "type": "row", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }, "collapsed": false },
    { "id": 5, "title": "커맨드별 OPS", "type": "timeseries", "gridPos": { "h": 6, "w": 12, "x": 0, "y": 7 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "expr": "topk(10, sum by (cmd) (rate(redis_commands_total[5m])))", "legendFormat": "{{cmd}}", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "ops" } } },
    { "id": 6, "title": "커맨드별 P99 지연", "type": "timeseries", "gridPos": { "h": 6, "w": 12, "x": 12, "y": 7 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "expr": "topk(10, redis:latency:command_p99) * 1000", "legendFormat": "{{cmd}}", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "ms" } } },
    { "id": 300, "title": "메모리", "type": "row", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 }, "collapsed": false },
    { "id": 7, "title": "메모리 사용량", "type": "timeseries", "gridPos": { "h": 5, "w": 8, "x": 0, "y": 14 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "expr": "redis:memory:used_bytes", "legendFormat": "사용량 {{instance}}", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "bytes" } } },
    { "id": 8, "title": "조각화 비율", "type": "timeseries", "gridPos": { "h": 5, "w": 8, "x": 8, "y": 14 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "expr": "redis:memory:fragmentation_ratio", "legendFormat": "조각화 {{instance}}", "refId": "A" }] },
    { "id": 9, "title": "Eviction 속도", "type": "timeseries", "gridPos": { "h": 5, "w": 8, "x": 16, "y": 14 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "expr": "redis:evicted:rate", "legendFormat": "Eviction/s", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "ops" } } },
    { "id": 400, "title": "연결/복제", "type": "row", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 }, "collapsed": false },
    { "id": 10, "title": "클라이언트 연결", "type": "timeseries", "gridPos": { "h": 5, "w": 12, "x": 0, "y": 20 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "expr": "redis:connections:current", "legendFormat": "현재", "refId": "A" }, { "expr": "redis:connections:blocked", "legendFormat": "차단", "refId": "B" }], "fieldConfig": { "defaults": { "unit": "short" } } },
    { "id": 11, "title": "복제 지연", "type": "timeseries", "gridPos": { "h": 5, "w": 12, "x": 12, "y": 20 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "expr": "redis:replication:lag_seconds", "legendFormat": "지연 (초)", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "s" } } },
    { "id": 500, "title": "지속성", "type": "row", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 }, "collapsed": false },
    { "id": 12, "title": "RDB 저장 시간 + Slow Log", "type": "timeseries", "gridPos": { "h": 5, "w": 12, "x": 0, "y": 26 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "expr": "redis:rdb:last_save_duration", "legendFormat": "RDB 저장 시간", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "s" } } },
    { "id": 13, "title": "Slow Log 수", "type": "timeseries", "gridPos": { "h": 5, "w": 12, "x": 12, "y": 26 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "expr": "redis:slowlog:count", "legendFormat": "Slow Log", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "short" } } }
  ],
  "schemaVersion": 39,
  "version": 1,
  "weekStart": "monday"
}
