{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus" }
  ],
  "annotations": { "list": [] },
  "description": "ConfigMap/Secret 변경 감지 대시보드 — 변경 추적, 감사 로깅, 비정상 변경 감지 (Design Ref: MTU-N188 §DS-N188.5, CSAP D-06/D-09)",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "변경 상태 개요",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(configmap:changes:rate5m{namespace=~\"$namespace\"}) or vector(0)",
          "legendFormat": "ConfigMap 변경 (5분)",
          "refId": "A"
        },
        {
          "expr": "sum(secret:changes:rate5m{namespace=~\"$namespace\"}) or vector(0)",
          "legendFormat": "Secret 변경 (5분)",
          "refId": "B"
        },
        {
          "expr": "sum(configmap:total:count{namespace=~\"$namespace\"}) or vector(0)",
          "legendFormat": "ConfigMap 총수",
          "refId": "C"
        },
        {
          "expr": "sum(secret:total:count{namespace=~\"$namespace\"}) or vector(0)",
          "legendFormat": "Secret 총수",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "title": "ConfigMap 변경 타임라인",
      "description": "Design Ref: DS-N188.1 — 네임스페이스별 ConfigMap 변경 추이",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "configmap:changes:rate5m{namespace=~\"$namespace\"}",
          "legendFormat": "{{ namespace }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 80, "stacking": { "mode": "normal" } },
          "unit": "short"
        }
      }
    },
    {
      "title": "Secret 변경 타임라인",
      "description": "Design Ref: DS-N188.2 — 네임스페이스별 Secret 변경 추이 (보안 감사 중점)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "secret:changes:rate5m{namespace=~\"$namespace\"}",
          "legendFormat": "{{ namespace }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 80, "stacking": { "mode": "normal" } },
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "title": "네임스페이스별 설정 변경 빈도",
      "description": "ConfigMap + Secret 합산 변경 수",
      "type": "bargauge",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "config:all_changes:rate5m{namespace=~\"$namespace\"}",
          "legendFormat": "{{ namespace }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "short"
        }
      }
    },
    {
      "title": "ConfigMap/Secret 총 개수 추세",
      "description": "Design Ref: DS-N188.5 — 네임스페이스별 리소스 수 추이",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "targets": [
        {
          "expr": "configmap:total:count{namespace=~\"$namespace\"}",
          "legendFormat": "ConfigMap: {{ namespace }}",
          "refId": "A"
        },
        {
          "expr": "secret:total:count{namespace=~\"$namespace\"}",
          "legendFormat": "Secret: {{ namespace }}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        }
      }
    },
    {
      "title": "최근 변경된 ConfigMap 목록",
      "description": "5분 내 변경 감지된 ConfigMap",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "targets": [
        {
          "expr": "configmap:change_detected:info{namespace=~\"$namespace\"} == 1",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Value": true, "__name__": true },
            "renameByName": { "namespace": "네임스페이스", "configmap": "ConfigMap명" }
          }
        }
      ]
    },
    {
      "title": "비정상 시간대 변경 히스토리",
      "description": "Design Ref: DS-N188.3 — 업무 시간 외 변경 추적",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 26 },
      "targets": [
        {
          "expr": "config:all_changes:rate5m{namespace=~\"$namespace\"} and on() (hour() >= 9 or hour() < 0)",
          "legendFormat": "비정상 시간 변경: {{ namespace }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 90
          },
          "color": { "fixedColor": "red", "mode": "fixed" },
          "unit": "short"
        }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["config-change", "secret", "configmap", "csap-d06", "csap-d09", "mtu-n188"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(kube_configmap_info, namespace)",
        "name": "namespace",
        "type": "query",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "Asia/Seoul",
  "title": "ConfigMap/Secret 변경 감지",
  "uid": "configmap-secret-change-n188",
  "version": 1
}
