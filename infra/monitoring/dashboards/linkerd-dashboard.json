{
  "annotations": { "list": [] },
  "description": "Linkerd 서비스 메시 모니터링 대시보드",
  "editable": true,
  "panels": [
    {
      "title": "메시 성공률 (전체)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum(rate(response_total{classification=\"success\", tls=\"true\"}[5m])) / sum(rate(response_total{tls=\"true\"}[5m])) * 100",
        "legendFormat": "성공률 %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      }
    },
    {
      "title": "mTLS 적용률",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum(rate(response_total{tls=\"true\"}[5m])) / sum(rate(response_total[5m])) * 100",
        "legendFormat": "mTLS %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          }
        }
      }
    },
    {
      "title": "서비스별 요청률 (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum by (deployment) (rate(request_total[5m]))",
        "legendFormat": "{{ deployment }}"
      }]
    },
    {
      "title": "서비스별 P99 지연 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "histogram_quantile(0.99, sum by (deployment, le) (rate(response_latency_ms_bucket[5m]))) ",
        "legendFormat": "{{ deployment }} p99"
      }],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "title": "TCP 연결 (mTLS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum by (peer) (tcp_open_connections{tls=\"true\"})",
        "legendFormat": "{{ peer }}"
      }]
    },
    {
      "title": "프록시 리소스 사용량",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{container=\"linkerd-proxy\"}) / 1024 / 1024",
          "legendFormat": "{{ pod }} 메모리(MB)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "MiB" } }
    }
  ],
  "schemaVersion": 39,
  "tags": ["linkerd", "service-mesh", "mtls", "zero-trust", "csap"],
  "time": { "from": "now-6h", "to": "now" },
  "title": "Linkerd 서비스 메시 모니터링",
  "uid": "linkerd-mesh-monitor",
  "version": 1
}
