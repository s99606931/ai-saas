# Gitea + Act Runner 환경 설정
# Design Ref: MTU-N10 | CSAP: D-09 (시크릿 관리)
#
# 사용법:
#   cp env.example .env
#   .env 파일의 비밀번호를 반드시 변경하십시오.
#
# [주의] .env 파일은 절대 버전 관리에 포함하지 마십시오.

# --- PostgreSQL (Gitea 전용) ---
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=CHANGE_ME_gitea_db_password
GITEA_DB_NAME=gitea

# --- Gitea ---
GITEA_ADMIN_USER=saas-admin
GITEA_ADMIN_PASSWORD=CHANGE_ME_gitea_admin_password
GITEA_ADMIN_EMAIL=admin@public-saas.local
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=2222
GITEA_ROOT_URL=http://localhost:3000

# --- Act Runner ---
# Gitea Site Administration > Actions > Runners 에서 등록 토큰 발급
RUNNER_REGISTRATION_TOKEN=CHANGE_ME_runner_token
RUNNER_NAME=wsl2-runner
RUNNER_LABELS=self-hosted,ubuntu-latest:host
