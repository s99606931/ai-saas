{
  "description": "Flux CD GitOps 동기화 모니터링 대시보드 (MTU-N172)",
  "editable": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 400,
      "title": "동기화 현황 요약",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }] } } },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Kustomization Ready",
      "type": "stat",
      "targets": [{ "expr": "flux:kustomization_ready_count", "legendFormat": "Ready" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Kustomization Not Ready",
      "type": "stat",
      "targets": [{ "expr": "flux:kustomization_not_ready_count", "legendFormat": "Not Ready" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }] } } },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "HelmRelease Ready",
      "type": "stat",
      "targets": [{ "expr": "flux:helmrelease_ready_count", "legendFormat": "Ready" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 90 }, { "color": "green", "value": 99 }] } } },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "동기화 성공률",
      "type": "stat",
      "targets": [{ "expr": "flux:sync_success_rate", "legendFormat": "성공률" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 401,
      "title": "리소스별 상태",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "title": "Kustomization 상태 상세",
      "type": "table",
      "targets": [{ "expr": "gotk_reconcile_condition{kind=\"Kustomization\",type=\"Ready\"}", "format": "table", "instant": true }],
      "transformations": [{ "id": "organize", "options": { "renameByName": { "name": "이름", "namespace": "네임스페이스", "status": "상태" } } }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "title": "HelmRelease 상태 상세",
      "type": "table",
      "targets": [{ "expr": "gotk_reconcile_condition{kind=\"HelmRelease\",type=\"Ready\"}", "format": "table", "instant": true }],
      "transformations": [{ "id": "organize", "options": { "renameByName": { "name": "이름", "namespace": "네임스페이스", "status": "상태" } } }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 402,
      "title": "리컨실 성능",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 7,
      "title": "리컨실 평균 소요 시간",
      "type": "timeseries",
      "targets": [{ "expr": "flux:reconcile_duration_avg_5m", "legendFormat": "{{ kind }}" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 2 } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 8,
      "title": "리컨실 P99 소요 시간",
      "type": "timeseries",
      "targets": [{ "expr": "flux:reconcile_duration_p99_5m", "legendFormat": "{{ kind }}" }]
    }
  ],
  "refresh": "30s",
