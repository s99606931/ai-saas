    {
      "title": "Deprecated API 사용률",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "targets": [
        { "expr": "api_versioning:deprecated_usage_ratio * 100", "legendFormat": "{{ service }} {{ path }}" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    }
  ],
