# Harbor 레지스트리 환경 설정
# Design Ref: MTU-N11 | CSAP: D-09 (시크릿 관리), D-11-04 (이미지 스캔)
#
# 사용법:
#   cp env.example .env
#   .env 파일의 비밀번호를 반드시 변경하십시오.
#
# [주의] .env 파일은 절대 버전 관리에 포함하지 마십시오.

# --- Harbor ---
HARBOR_ADMIN_PASSWORD=CHANGE_ME_harbor_admin_password
HARBOR_HTTP_PORT=8080
HARBOR_VERSION=v2.11.2
HARBOR_DATA_VOLUME=/data/harbor
HARBOR_PROJECT_NAME=public-saas

# --- Harbor 설치 디렉토리 ---
HARBOR_INSTALL_DIR=/opt/harbor
