// 공공기관 SaaS 플랫폼 — 공통 DB 스키마
// Design Ref: D-P00.6 DB 스키마
// Plan SC: FR-P00.6
// CSAP: D-06 감사 로그, D-08 접근 통제, D-09 암호화

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 인증/사용자 (CSAP D-08)
// ============================================================

model User {
  id           String    @id @default(cuid())
  tenantId     String
  email        String
  name         String
  passwordHash String    // bcrypt cost=12 (CSAP D-08)
  role         UserRole  @default(USER)
  mfaEnabled   Boolean   @default(false)
  mfaSecret    String?   // AES-256 암호화 저장 (CSAP D-09)
  lastLoginAt  DateTime?
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  sessions  Session[]
  auditLogs AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  USER
  VIEWER
  AUDITOR
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  token            String   @unique
  expiresAt        DateTime // 15분 만료 (CSAP D-08)
  refreshToken     String?  @unique
  refreshExpiresAt DateTime? // 7일
  ip               String
  userAgent        String
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique // resource:action 형식
  description String?
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  role         UserRole
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
}

// ============================================================
// 테넌트 (N2SF N-03 격리)
// ============================================================

model Tenant {
  id         String       @id @default(cuid())
  name       String
  slug       String       @unique
  status     TenantStatus @default(TRIAL)
  maxUsers   Int          @default(10)
  maxStorage BigInt       @default(1073741824) // 1GB
  config     Json?
  theme      Json?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  users         User[]
  subscriptions Subscription[]
  menuItems     MenuItem[]
  auditLogs     AuditLog[]

  @@index([slug])
  @@index([status])
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  ARCHIVED
}

// ============================================================
// SaaS 서비스 카탈로그
// ============================================================

model Service {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  category    String
  version     String   @default("1.0.0")
  isBuiltIn   Boolean  @default(false)
  isActive    Boolean  @default(true)
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  featureFlags FeatureFlag[]
  plans        PlanService[]
}

model FeatureFlag {
  id        String  @id @default(cuid())
  serviceId String
  key       String
  enabled   Boolean @default(false)
  config    Json?

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, key])
}

// ============================================================
// 구독 관리
// ============================================================

model Plan {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  price      Decimal  @db.Decimal(10, 2)
  currency   String   @default("KRW")
  interval   String   @default("monthly")
  maxUsers   Int
  maxStorage BigInt
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  services      PlanService[]
  subscriptions Subscription[]
}

model PlanService {
  id        String @id @default(cuid())
  planId    String
  serviceId String

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([planId, serviceId])
}

model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@index([tenantId])
  @@index([status])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

// ============================================================
// 빌링
// ============================================================

model Invoice {
  id             String    @id @default(cuid())
  subscriptionId String
  amount         Decimal   @db.Decimal(10, 2)
  currency       String    @default("KRW")
  status         String    @default("draft")
  issuedAt       DateTime?
  paidAt         DateTime?
  dueDate        DateTime
  createdAt      DateTime  @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  payments     Payment[]

  @@index([subscriptionId])
  @@index([status])
}

model Payment {
  id        String    @id @default(cuid())
  invoiceId String
  amount    Decimal   @db.Decimal(10, 2)
  method    String
  status    String    @default("pending")
  paidAt    DateTime?
  createdAt DateTime  @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

// ============================================================
// CRM
// ============================================================

model Customer {
  id        String   @id @default(cuid())
  tenantId  String?
  name      String
  industry  String?
  size      String?
  status    String   @default("prospect")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts  Contact[]
  contracts Contract[]

  @@index([status])
}

model Contact {
  id         String  @id @default(cuid())
  customerId String
  name       String
  email      String
  phone      String?
  role       String?
  isPrimary  Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Contract {
  id         String   @id @default(cuid())
  customerId String
  title      String
  value      Decimal  @db.Decimal(12, 2)
  startDate  DateTime
  endDate    DateTime
  status     String   @default("draft")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([status])
}

// ============================================================
// 메뉴 관리
// ============================================================

model MenuItem {
  id        String  @id @default(cuid())
  tenantId  String?
  parentId  String?
  label     String
  path      String
  icon      String?
  order     Int     @default(0)
  isVisible Boolean @default(true)
  roles     Json?

  tenant   Tenant?    @relation(fields: [tenantId], references: [id])
  parent   MenuItem?  @relation("MenuTree", fields: [parentId], references: [id])
  children MenuItem[] @relation("MenuTree")

  @@index([tenantId])
  @@index([parentId])
}

// ============================================================
// 감사 로그 (CSAP D-06) — append-only, SHA-256 체인
// ============================================================

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String?
  actorId      String?
  action       String
  target       String?
  targetType   String?
  ip           String?
  userAgent    String?
  metadata     Json?
  hash         String   // SHA-256 체인
  previousHash String   // 이전 로그 해시 (무결성 검증)
  createdAt    DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  actor  User?   @relation(fields: [actorId], references: [id])

  @@index([tenantId, createdAt])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================
// AI 서비스 (N2SF N-05)
// ============================================================

model AiModel {
  id       String  @id @default(cuid())
  name     String
  provider String
  endpoint String
  maxGrade String  @default("O") // C, S, O
  isActive Boolean @default(true)
  config   Json?
  createdAt DateTime @default(now())

  usages AiUsage[]
}

model AiUsage {
  id        String   @id @default(cuid())
  modelId   String
  tenantId  String
  tokens    Int
  cost      Decimal  @db.Decimal(10, 4)
  grade     String
  createdAt DateTime @default(now())

  model AiModel @relation(fields: [modelId], references: [id])

  @@index([tenantId, createdAt])
  @@index([modelId])
}

// ============================================================
// 알림
// ============================================================

model Notification {
  id        String    @id @default(cuid())
  tenantId  String?
  userId    String?
  channel   String
  subject   String
  body      String
  status    String    @default("pending")
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([status])
}

// ============================================================
// 파일 관리 (CSAP D-09 AES-256 암호화)
// ============================================================

model File {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  mimeType    String
  size        BigInt
  storagePath String
  encrypted   Boolean  @default(true)
  uploadedBy  String
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([uploadedBy])
}
