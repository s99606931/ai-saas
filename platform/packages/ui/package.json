{
  "name": "@public-saas/ui",
  "version": "0.1.0",
  "private": true,
  "description": "공공기관 SaaS 플랫폼 — 공통 UI 컴포넌트 (shadcn/ui 확장)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./tokens.css": "./src/tokens/index.css",
    "./tokens/base.css": "./src/tokens/base.css",
    "./tokens/semantic.css": "./src/tokens/semantic.css",
    "./tokens/component.css": "./src/tokens/component.css",
    "./tokens/themes/default.css": "./src/tokens/themes/default.css",
    "./tokens/themes/dark.css": "./src/tokens/themes/dark.css",
    "./tokens/themes/government.css": "./src/tokens/themes/government.css",
    "./tokens/themes/finance.css": "./src/tokens/themes/finance.css",
    "./tokens/themes/healthcare.css": "./src/tokens/themes/healthcare.css",
    "./tokens/themes/high-contrast.css": "./src/tokens/themes/high-contrast.css",
    "./atoms/*": {
      "types": "./dist/atoms/*.d.ts",
      "import": "./dist/atoms/*.js"
    },
    "./molecules/*": {
      "types": "./dist/molecules/*.d.ts",
      "import": "./dist/molecules/*.js"
    },
    "./organisms/*": {
      "types": "./dist/organisms/*.d.ts",
      "import": "./dist/organisms/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@public-saas/types": "workspace:*",
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "tailwind-merge": "^2.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^2.1.8",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
