{
  "name": "@public-saas/api-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "공공기관 SaaS 플랫폼 — API 게이트웨이 (Fastify 5)",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --max-warnings 0",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@public-saas/observability": "workspace:*",
    "@public-saas/types": "workspace:*",
    "@public-saas/auth-sdk": "workspace:*",
    "@public-saas/audit-sdk": "workspace:*",
    "fastify": "^5.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/http-proxy": "^11.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "jose": "^5.9.0",
    "zod": "^3.23.0",
    "pino": "^9.0.0",
    "@public-saas/health": "workspace:*",
    "@public-saas/rbac": "workspace:*",
    "@public-saas/api-version": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
